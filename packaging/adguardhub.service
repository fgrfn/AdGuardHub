# AdGuardHub service, generated by install.sh from the template in the release.
#
# Do not edit this file: the next upgrade replaces it. Your own settings belong
# in /etc/adguardhub/adguardhub.env, which upgrades never touch.
[Unit]
Description=AdGuardHub — one dashboard for several AdGuard Home instances
Documentation=https://github.com/fgrfn/adguardhub
# network-online rather than network: the hub talks to its nodes on start, and
# "an interface exists" is not the same as "the LAN is reachable".
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@USER@
Group=@USER@
WorkingDirectory=@PREFIX@
Environment=ADGUARDHUB_DATA_DIR=@DATA@
Environment=ADGUARDHUB_STATIC_DIR=@PREFIX@/static
Environment=ADGUARDHUB_VERSION=@VERSION@
# So the hub knows an upgrade here means re-running install.sh, rather than
# telling you to pull an image you are not using.
Environment=ADGUARDHUB_INSTALL_METHOD=native
# The dash means "carry on if it does not exist". This is where your own
# settings go — ADGUARDHUB_SECRET_KEY, log level, timers.
EnvironmentFile=-/etc/adguardhub/adguardhub.env
# --timeout-graceful-shutdown, because uvicorn's default is to wait forever for
# the requests still in flight, and an event stream is a request that does not
# end on its own. The hub closes its streams on shutdown (see EventBus.close),
# so this should never be reached; it is here so that a request nobody thought
# of costs five seconds rather than the ninety systemd allows before SIGKILL.
ExecStart=@PREFIX@/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port @PORT@ --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=5
# Half a minute is plenty for a process that should stop in milliseconds, and it
# turns "the upgrade hung" into "the upgrade took a moment".
TimeoutStopSec=30

# The hub holds the admin credentials of your DNS infrastructure, so it runs
# with as little as it can. It needs exactly two things beyond a normal user:
# to write its own data directory, and to bind a privileged port.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=@DATA@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
